    "range_list = [mx - mn for mx, mn in zip(max_list, min_list)]\n",
    "list_time = time.time() - start\n",
    "\n",
    "# NumPy arrays\n",
    "min_arr = np.arange(10, n + 10)\n",
    "max_arr = np.arange(50, n + 50)\n",
