   "source": [
    "# Rush-hour congestion map — color-coded by severity, sized by vehicle count\n",
    "center = [worst_congestion['LATITUDE'].mean(), worst_congestion['LONGITUDE'].mean()]\n",
    "m_rush = folium.Map(location=center, zoom_start=11, tiles='cartodbpositron')\n",
    "\n",
    "# Add alternative tile layers\n",
    "folium.TileLayer('OpenStreetMap', name='Street Map').add_to(m_rush)\n",
    "folium.TileLayer('cartodbdark_matter', name='Dark').add_to(m_rush)\n",
    "\n",
    "# Color-coded circle markers sized by vehicle count\n",
    "for _, row in worst_congestion.iterrows():\n",
    "    speed = row['AVERAGE_SPEED']\n",
    "    vehicles = row['NUMBER_OF_VEHICLES']\n",
    "    color = 'darkred' if speed < 10 else ('red' if speed < 15 else 'orange')\n",
    "    radius = max(3, min(12, vehicles / 5))\n",
    "    folium.CircleMarker(\n",
    "        location=[row['LATITUDE'], row['LONGITUDE']],\n",
    "        radius=radius,\n",
    "        color=color,\n",
    "        fill=True,\n",
    "        fill_color=color,\n",
    "        fill_opacity=0.7,\n",
    "        popup=folium.Popup(\n",
    "            f\"<b>Speed:</b> {speed} km/h<br>\"\n",
    "            f\"<b>Vehicles:</b> {vehicles}<br>\"\n",
    "            f\"<b>Time:</b> {row['DATE_TIME']}\",\n",
    "            max_width=200\n",
    "        )\n",
    "    ).add_to(m_rush)\n",
    "\n",
    "# Bridge markers for context\n",
    "for name, coords in bridges_info.items():\n",
    "    folium.Marker(\n",
    "        location=coords,\n",
    "        popup=f'<b>{name}</b>',\n",
    "        icon=folium.Icon(color='darkblue', icon='road', prefix='fa')\n",
    "    ).add_to(m_rush)\n",
    "\n",
    "folium.LayerControl().add_to(m_rush)\n",
    "\n",
    "print(f\"Severe congestion map: {len(worst_congestion)} events\")\n",
    "print(\"   Marker size = vehicle count | Color = speed severity\")\n",
    "print(\"   Dark red < 10 km/h | Red < 15 | Orange < 20\")\n",
    "m_rush"
   ]
