   "source": [
    "# EVIDENCE MAP 4: The Recommendation\n",
    "m4 = folium.Map(location=[41.12, 29.07], zoom_start=11, tiles='cartodbpositron')\n",
    "\n",
    "# Bridge coverage circles (colored by performance)\n",
    "bridge_perf_colors = {}\n",
    "for bname in bridges:\n",
    "    if bname in bridge_hourly.columns:\n",
    "        avg = bridge_hourly[bname].mean()\n",
    "        bridge_perf_colors[bname] = 'red' if avg < 30 else ('orange' if avg < 40 else 'green')\n",
    "    else:\n",
    "        bridge_perf_colors[bname] = 'gray'\n",
    "\n",
    "for bname, (blat, blon) in bridges.items():\n",
    "    color = bridge_perf_colors.get(bname, 'gray')\n",
    "    folium.Circle(\n",
    "        location=[blat, blon], radius=3000,\n",
    "        color=color, fill=True, fill_opacity=0.15,\n",
    "        popup=f'{bname} (3 km coverage)'\n",
    "    ).add_to(m4)\n",
    "    folium.Marker(\n",
    "        location=[blat, blon], popup=f'<b>{bname}</b>',\n",
    "        icon=folium.Icon(color='darkblue', icon='road', prefix='fa')\n",
    "    ).add_to(m4)\n",
    "\n",
    "# Severe congestion dots\n",
    "severe_df = df[df['AVERAGE_SPEED'] < 15]\n",
    "n_severe_sample = min(500, len(severe_df))\n",
    "if n_severe_sample > 0:\n",
    "    severe_sample = severe_df.sample(n_severe_sample, random_state=42)\n",
    "    for _, row in severe_sample.iterrows():\n",
    "        folium.CircleMarker(\n",
    "            location=[row['LATITUDE'], row['LONGITUDE']],\n",
    "            radius=2, color='red', fill=True, fill_opacity=0.4, weight=0\n",
    "        ).add_to(m4)\n",
    "\n",
    "# Proposed 4th bridge\n",
    "folium.Marker(\n",
    "    location=[proposed_lat, proposed_lon],\n",
    "    popup='<b>PROPOSED: 4th Bosphorus Bridge</b><br>Kavacik-Beykoz Corridor',\n",
    "    icon=folium.Icon(color='green', icon='star', prefix='fa')\n",
    ").add_to(m4)\n",
    "\n",
