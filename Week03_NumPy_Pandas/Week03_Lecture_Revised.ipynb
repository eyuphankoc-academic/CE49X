    "from folium.plugins import HeatMapWithTime\n",
    "\n",
    "# Make sure Hour exists and is numeric (robust if earlier cells were skipped/re-run)\n",
    "if 'Hour' not in df.columns:\n",
    "    df['Hour'] = pd.to_datetime(df['DATE_TIME']).dt.hour\n",
    "df['Hour'] = pd.to_numeric(df['Hour'], errors='coerce').astype('Int64')\n",
    "\n",
    "# Keep only rows needed by the animation\n",
    "anim_df = df.dropna(subset=['LATITUDE', 'LONGITUDE', 'AVERAGE_SPEED', 'Hour']).copy()\n",
    "anim_df['Hour'] = anim_df['Hour'].astype(int)\n",
    "\n",
    "# Global scale for comparable intensity across frames\n",
    "global_min = float(anim_df['AVERAGE_SPEED'].min())\n",
    "global_max = float(anim_df['AVERAGE_SPEED'].max())\n",
    "speed_range = max(global_max - global_min, 1e-9)\n",
    "\n",
    "heat_by_hour = []\n",
    "hour_labels = []\n",
    "frame_sizes = []\n",
    "\n",
    "for hour in range(24):\n",
    "    hour_df = anim_df[anim_df['Hour'] == hour]\n",
    "\n",
    "    # Lighter frames = smoother live playback in notebooks\n",
    "    if len(hour_df) > 800:\n",
    "        hour_df = hour_df.sample(800, random_state=42)\n",
    "\n",
    "    speeds = hour_df['AVERAGE_SPEED'].to_numpy(dtype=float)\n",
    "    intens = 1 - (speeds - global_min) / speed_range\n",
    "\n",
    "    points = [\n",
    "        [float(lat), float(lon), float(w)]\n",
    "        for lat, lon, w in zip(hour_df['LATITUDE'], hour_df['LONGITUDE'], intens)\n",
    "    ]\n",
    "\n",
    "    heat_by_hour.append(points)\n",
    "    hour_labels.append(f'{hour:02d}:00')\n",
    "    frame_sizes.append(len(points))\n",
    "\n",
    "m3 = folium.Map(location=[41.08, 29.05], zoom_start=11, tiles='cartodbdark_matter')\n",
    "HeatMapWithTime(\n",
    "    heat_by_hour,\n",
    "    index=hour_labels,\n",
    "    radius=14,\n",
    "    blur=10,\n",
    "    min_opacity=0.25,\n",
    "    max_opacity=0.85,\n",
    "    use_local_extrema=True,\n",
    "    auto_play=True,\n",
    "    min_speed=1,\n",
    "    max_speed=10,\n",
    "    speed_step=1\n",
    ").add_to(m3)\n",
    "\n",
    "for name, coords in bridges_info.items():\n",
    "    folium.Marker(\n",
    "        coords,\n",
    "        popup=name,\n",
    "        icon=folium.Icon(color='white', icon='road', prefix='fa')\n",
    "    ).add_to(m3)\n",
    "\n",
    "print(f\"EVIDENCE MAP 3: 24-hour congestion animation ({len(heat_by_hour)} frames)\")\n",
    "print(f\"  Non-empty frames: {sum(n > 0 for n in frame_sizes)}/24\")\n",
    "print(\"  If autoplay is blocked by your browser/notebook frontend, press play once.\")\n",
    "m3"
   ]
