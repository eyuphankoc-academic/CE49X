  {
   "cell_type": "code",
   "execution_count": 70,
   "id": "vectorized-demo",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-02-23T19:04:26.572798Z",
     "iopub.status.busy": "2026-02-23T19:04:26.572715Z",
