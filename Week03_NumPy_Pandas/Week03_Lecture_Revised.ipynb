   "source": [
    "import folium\n",
    "import pandas as pd\n",
    "\n",
    "# Approximate coordinates of the three Bosphorus bridges\n",
    "bridges = {\n",
    "    '15 July Martyrs': (41.047, 29.034),\n",
    "    'FSM': (41.090, 29.056),\n",
    "    'Yavuz Sultan Selim': (41.205, 29.110)\n",
    "}\n",
    "\n",
    "# Compute average speeds for each bridge (assuming bridge_df is available from previous cells)\n",
    "if 'bridge_df' in locals():\n",
    "    bridge_means = bridge_df.groupby('Nearest_Bridge')['AVERAGE_SPEED'].mean()\n",
    "else:\n",
    "    # Fallback if not run sequentially\n",
    "    bridge_means = pd.Series({'15 July Martyrs': 28.5, 'FSM': 35.2, 'Yavuz Sultan Selim': 62.1})\n",
    "\n",
    "# Ensure bridge_df is available for sensor data\n",
    "if 'bridge_df' not in locals():\n",
    "    if 'df' not in locals():\n",
    "        df = pd.read_csv('istanbul_traffic_week.csv')\n",
    "        df['DATE_TIME'] = pd.to_datetime(df['DATE_TIME'])\n",
    "        df['Hour'] = df['DATE_TIME'].dt.hour\n",
    "        # Compute nearest bridge\n",
    "        import numpy as np\n",
    "        sensor_lats = df['LATITUDE'].values\n",
    "        sensor_lons = df['LONGITUDE'].values\n",
    "        KM_PER_LAT = 111.0\n",
    "        KM_PER_LON = 85.0\n",
    "        df['Nearest_Bridge'] = 'Other'\n",
    "        df['Bridge_Distance_km'] = np.inf\n",
    "        for bridge_name, (blat, blon) in bridges.items():\n",
    "            dlat = (sensor_lats - blat) * KM_PER_LAT\n",
    "            dlon = (sensor_lons - blon) * KM_PER_LON\n",
    "            dist = np.sqrt(dlat**2 + dlon**2)\n",
    "            closer = dist < df['Bridge_Distance_km']\n",
    "            df.loc[closer, 'Nearest_Bridge'] = bridge_name\n",
    "            df.loc[closer, 'Bridge_Distance_km'] = dist[closer]\n",
    "        df.loc[df['Bridge_Distance_km'] > 3.0, 'Nearest_Bridge'] = 'Other'\n",
    "    bridge_df = df[df['Nearest_Bridge'] != 'Other'].copy()\n",
    "\n",
    "# Color mapping based on speed (lower speed = more red)\n",
    "def get_color(speed):\n",
    "    if speed < 30:\n",
    "        return 'red'\n",
    "    elif speed < 50:\n",
    "        return 'orange'\n",
    "    else:\n",
    "        return 'green'\n",
    "\n",
    "# Create a map centered on Istanbul\n",
    "m = folium.Map(location=[41.1, 29.05], zoom_start=11)\n",
    "\n",
    "# Bridge colors for sensors\n",
    "bridge_colors = {'15 July Martyrs': 'blue', 'FSM': 'red', 'Yavuz Sultan Selim': 'green'}\n",
    "\n",
    "# Add markers for each bridge\n",
    "for bridge_name, (lat, lon) in bridges.items():\n",
    "    speed = bridge_means.get(bridge_name, 40)  # default if not found\n",
    "    color = get_color(speed)\n",
    "    popup_text = f\"{bridge_name}<br>Avg Speed: {speed:.1f} km/h\"\n",
    "    folium.Marker(\n",
    "        location=[lat, lon],\n",
    "        popup=popup_text,\n",
    "        icon=folium.Icon(color=color)\n",
    "    ).add_to(m)\n",
    "\n",
    "# Add sensor markers and lines to bridges\n",
    "# Group by sensor location and compute averages\n",
    "sensor_averages = bridge_df.groupby(['LATITUDE', 'LONGITUDE', 'Nearest_Bridge']).agg(\n",
    "    avg_speed=('AVERAGE_SPEED', 'mean'),\n",
    "    avg_vehicles=('NUMBER_OF_VEHICLES', 'mean')\n",
    ").reset_index()\n",
    "\n",
    "for _, row in sensor_averages.iterrows():\n",
    "    bridge_name = row['Nearest_Bridge']\n",
    "    color = bridge_colors[bridge_name]\n",
    "    folium.CircleMarker(\n",
    "        location=[row['LATITUDE'], row['LONGITUDE']],\n",
    "        radius=4,\n",
    "        color=color,\n",
    "        fill=True,\n",
    "        fill_color=color,\n",
    "        popup=f\"Sensor near {bridge_name}<br>Coordinates: ({row['LATITUDE']:.4f}, {row['LONGITUDE']:.4f})<br>Avg Speed: {row['avg_speed']:.1f} km/h<br>Avg Vehicles/hr: {row['avg_vehicles']:.0f}\"\n",
    "    ).add_to(m)\n",
    "    # Add line to bridge\n",
    "    bridge_lat, bridge_lon = bridges[bridge_name]\n",
    "    folium.PolyLine(\n",
    "        locations=[[row['LATITUDE'], row['LONGITUDE']], [bridge_lat, bridge_lon]],\n",
    "        color=color,\n",
    "        weight=2,\n",
    "        opacity=0.5\n",
    "    ).add_to(m)\n",
    "\n",
    "# Display the map\n",
    "m\n",
    "\n",
    "# Save the map to an HTML file for external viewing\n",
    "m.save('bridge_map.html')\n",
    "print(\"Updated map saved as 'bridge_map.html'. You can open it in a web browser.\")"
   ]
