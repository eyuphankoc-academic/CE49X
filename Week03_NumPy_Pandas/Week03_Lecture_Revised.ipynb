    "# Randomly set 5% of AVERAGE_SPEED to NaN\n",
    "mask = np.random.random(len(df_missing)) < 0.05\n",
    "df_missing.loc[mask, 'AVERAGE_SPEED'] = np.nan\n",
    "df_missing.loc[mask, 'MINIMUM_SPEED'] = np.nan\n",
    "df_missing.loc[mask, 'MAXIMUM_SPEED'] = np.nan\n",
    "\n",
    "print(f\"Missing values per column:\")\n",
    "print(df_missing[['AVERAGE_SPEED', 'MINIMUM_SPEED', 'MAXIMUM_SPEED']].isnull().sum())\n",
    "print(f\"\\nTotal rows: {len(df_missing):,}\")\n",
    "print(f\"Rows with missing speed: {df_missing['AVERAGE_SPEED'].isnull().sum():,} ({mask.mean():.1%})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "missing-handle",
   "metadata": {},
   "source": [
    "### Three Strategies for Missing Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 111,
   "id": "missing-strategies",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-02-23T19:04:27.049523Z",
