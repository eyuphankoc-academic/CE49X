   "source": [
    "import folium\n",
    "\n",
    "# Per-sensor average speed (group by unique lat/lon)\n",
    "sensor_coords = np.column_stack([lat, lon])\n",
    "unique_sensors, inverse = np.unique(sensor_coords, axis=0, return_inverse=True)\n",
    "\n",
    "sensor_avg_speed = np.zeros(len(unique_sensors))\n",
    "sensor_count = np.zeros(len(unique_sensors))\n",
    "np.add.at(sensor_avg_speed, inverse, avg_speed)\n",
    "np.add.at(sensor_count, inverse, 1)\n",
    "sensor_avg_speed /= sensor_count\n",
    "\n",
    "# Bridge locations (we'll reuse this throughout the notebook)\n",
    "bridges_info = {\n",
    "    '15 July Martyrs Bridge': [41.047, 29.034],\n",
    "    'FSM Bridge': [41.090, 29.056],\n",
    "    'Yavuz Sultan Selim Bridge': [41.205, 29.110]\n",
    "}\n",
    "\n",
    "# Build map\n",
    "m1 = folium.Map(location=[41.08, 29.05], zoom_start=11, tiles='cartodbpositron')\n",
    "\n",
    "for i in range(len(unique_sensors)):\n",
    "    s = sensor_avg_speed[i]\n",
    "    color = 'green' if s > 40 else ('orange' if s > 20 else 'red')\n",
    "    folium.CircleMarker(\n",
    "        location=[unique_sensors[i, 0], unique_sensors[i, 1]],\n",
    "        radius=4,\n",
    "        color=color,\n",
    "        fill=True,\n",
    "        fill_opacity=0.7,\n",
    "        popup=f'Avg Speed: {s:.0f} km/h'\n",
    "    ).add_to(m1)\n",
    "\n",
    "for name, coords in bridges_info.items():\n",
    "    folium.Marker(\n",
    "        location=coords,\n",
    "        popup=name,\n",
    "        icon=folium.Icon(color='darkblue', icon='road', prefix='fa')\n",
    "    ).add_to(m1)\n",
    "\n",
    "print(f\"EVIDENCE MAP 1: {len(unique_sensors)} sensor locations across Istanbul\")\n",
    "print(\"  Red = avg speed < 20 km/h | Orange = 20-40 | Green = > 40\")\n",
    "m1"
   ]
  },
