   "source": [
    "### Gap Analysis: Where Is Bridge Coverage Missing?\n",
    "\n",
    "The three bridges are not evenly spaced along the Bosphorus. Let's compute the distances between them to find the largest coverage gap."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 106,
   "id": "gap-analysis",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "BRIDGE GAP ANALYSIS\n",
      "==================================================\n",
      "  15 July Martyrs      <-> FSM                 : 5.1 km\n",
      "  15 July Martyrs      <-> Yavuz Sultan Selim  : 18.7 km\n",
      "  FSM                  <-> Yavuz Sultan Selim  : 13.6 km\n",
      "\n",
      ">>> CRITICAL FINDING: FSM to Yavuz Sultan Selim gap = 13.6 km\n",
      "    This is more than DOUBLE the gap between 15 July Martyrs and FSM!\n",
      "\n",
      "    Proposed 4th bridge: (41.148, 29.083)\n",
      "    Near the Kavacik-Beykoz corridor\n"
     ]
    }
   ],
   "source": [
    "# Gap analysis: how far apart are the bridges?\n",
    "print(\"BRIDGE GAP ANALYSIS\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "bridge_names = list(bridges.keys())\n",
    "bridge_coords = list(bridges.values())\n",
    "\n",
    "for i in range(len(bridge_names)):\n",
    "    for j in range(i + 1, len(bridge_names)):\n",
    "        dlat = (bridge_coords[i][0] - bridge_coords[j][0]) * KM_PER_LAT\n",
    "        dlon = (bridge_coords[i][1] - bridge_coords[j][1]) * KM_PER_LON\n",
    "        dist = np.sqrt(dlat**2 + dlon**2)\n",
    "        print(f\"  {bridge_names[i]:20s} <-> {bridge_names[j]:20s}: {dist:.1f} km\")\n",
    "\n",
    "# The critical gap\n",
    "fsm = bridges['FSM']\n",
    "yss = bridges['Yavuz Sultan Selim']\n",
    "fsm_yss_dist = np.sqrt(((fsm[0] - yss[0]) * KM_PER_LAT)**2 +\n",
    "                        ((fsm[1] - yss[1]) * KM_PER_LON)**2)\n",
    "\n",
    "# Proposed 4th bridge: midpoint of the gap\n",
    "proposed_lat = (fsm[0] + yss[0]) / 2\n",
    "proposed_lon = (fsm[1] + yss[1]) / 2\n",
    "\n",
    "print(f\"\\n>>> CRITICAL FINDING: FSM to Yavuz Sultan Selim gap = {fsm_yss_dist:.1f} km\")\n",
    "print(\"    This is more than DOUBLE the gap between 15 July Martyrs and FSM!\")\n",
    "print(f\"\\n    Proposed 4th bridge: ({proposed_lat:.3f}, {proposed_lon:.3f})\")\n",
    "print(f\"    Near the Kavacik-Beykoz corridor\")"
   ]
  },
