   "cell_type": "markdown",
   "id": "distance-intro",
   "metadata": {},
   "source": [
    "### Broadcasting for Distance: How Far Apart Are Sensors?\n",
    "\n",
    "Given sensor latitudes and longitudes, we can compute a **pairwise distance matrix** using broadcasting — no loops needed."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "distance-demo",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-02-23T19:04:26.580321Z",
     "iopub.status.busy": "2026-02-23T19:04:26.580228Z",
     "iopub.status.idle": "2026-02-23T19:04:26.582795Z",
     "shell.execute_reply": "2026-02-23T19:04:26.582492Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Pairwise distances (km):\n",
      "[[ 0.   5.5  1.5 19. ]\n",
      " [ 5.5  0.   4.1 13.6]\n",
      " [ 1.5  4.1  0.  17.7]\n",
      " [19.  13.6 17.7  0. ]]\n",
      "\n",
      "Farthest pair: 19.0 km\n"
     ]
    }
   ],
   "source": [
    "# Sensor locations (latitude, longitude) for 4 sensors\n",
    "lats = np.array([41.045, 41.090, 41.055, 41.205])\n",
    "lons = np.array([29.034, 29.060, 29.045, 29.115])\n",
    "\n",
    "# Approximate distance in km using Euclidean on lat/lon\n",
    "# (1 degree lat ≈ 111 km, 1 degree lon ≈ 85 km at Istanbul's latitude)\n",
    "KM_PER_LAT = 111.0\n",
    "KM_PER_LON = 85.0\n",
    "\n",
    "# Broadcasting: shape (4,1) - (1,4) → (4,4) pairwise differences\n",
    "dlat = (lats[:, np.newaxis] - lats[np.newaxis, :]) * KM_PER_LAT\n",
    "dlon = (lons[:, np.newaxis] - lons[np.newaxis, :]) * KM_PER_LON\n",
    "distances = np.sqrt(dlat**2 + dlon**2)\n",
    "\n",
    "print(\"Pairwise distances (km):\")\n",
    "print(np.round(distances, 1))\n",
    "print(f\"\\nFarthest pair: {distances.max():.1f} km\")"
   ]
  },
