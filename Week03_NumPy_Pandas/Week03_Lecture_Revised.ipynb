    "from folium.plugins import HeatMap\n",
    "\n",
    "# Congestion heat map: intensity = inverse of speed (slower = hotter)\n",
    "intensity = 1 - (avg_speed - avg_speed.min()) / (avg_speed.max() - avg_speed.min())\n",
    "\n",
    "# Sample 5000 points for performance\n",
    "np.random.seed(42)\n",
    "sample_idx = np.random.choice(len(lat), size=5000, replace=False)\n",
    "heat_data = [[float(lat[i]), float(lon[i]), float(intensity[i])] for i in sample_idx]\n",
    "\n",
    "m2 = folium.Map(location=[41.08, 29.05], zoom_start=11, tiles='cartodbdark_matter')\n",
    "HeatMap(heat_data, radius=12, blur=15, max_zoom=13).add_to(m2)\n",
    "\n",
    "# Bridge markers for reference\n",
    "for name, coords in bridges_info.items():\n",
    "    folium.Marker(coords, popup=name,\n",
    "                  icon=folium.Icon(color='white', icon='road', prefix='fa')).add_to(m2)\n",
    "\n",
    "print(f\"EVIDENCE MAP 2: Congestion heat map ({len(sample_idx):,} sampled readings)\")\n",
    "print(\"  Brighter = slower traffic (more congested)\")\n",
    "print(\"  Notice: congestion clusters around bridge approaches and ring roads\")\n",
    "m2"
   ]
  },
